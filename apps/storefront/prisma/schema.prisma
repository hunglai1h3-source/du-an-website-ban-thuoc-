// Prisma Schema for H4CARE Storefront Prescription Module
// Phase 3: Document Processing + OCR Pipeline

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Prescription {
  id               String                 @id @default(uuid())
  userId           String?                // Nullable khi khách hàng chưa đăng nhập tài khoản
  sessionId        String?                // Mã phiên duyệt để đối soát nếu người dùng là khách vãng lai
  originalFileName String                 // Tên file gốc người dùng tải lên (chỉ dùng hiển thị/metadata)
  storedFileName   String                 // Tên file an toàn do máy chủ sinh: <uuid>.<ext>
  storageKey       String                 // Khóa định danh lưu trữ (ví dụ: prescriptions/2026/09/<uuid>.<ext>)
  filePath         String                 // Đường dẫn vật lý private trên server (tuyệt đối không public)
  mimeType         String                 // image/jpeg, image/png, application/pdf
  fileExtension    String                 // .jpg, .jpeg, .png, .pdf
  fileSize         Int                    // Kích thước tệp (bytes)
  status           String                 @default("STORED") // UPLOADED, STORED, PROCESSING, OCR_COMPLETED, OCR_FAILED...
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  ocrResult        PrescriptionOcrResult?
  extraction       PrescriptionExtraction?

  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionOcrResult {
  id                String                @id @default(uuid())
  prescriptionId    String                @unique
  prescription      Prescription          @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  provider          String                // "tesseract" | "google_vision" | "mock"
  status            String                // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  fullText          String                // Toàn bộ văn bản thô trích xuất từ tài liệu
  pageCount         Int                   @default(1)
  averageConfidence Float?                // Độ tin cậy trung bình thực tế (0.0 - 1.0) hoặc null
  processingTimeMs  Int?                  // Thời gian hoàn tất OCR (ms)
  attemptCount      Int                   @default(1)
  errorMessage      String?
  errorCode         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  pages             PrescriptionOcrPage[]

  @@index([prescriptionId])
  @@index([status])
  @@map("prescription_ocr_results")
}

model PrescriptionOcrPage {
  id          String                @id @default(uuid())
  ocrResultId String
  ocrResult   PrescriptionOcrResult @relation(fields: [ocrResultId], references: [id], onDelete: Cascade)
  pageNumber  Int
  text        String
  confidence  Float?
  createdAt   DateTime              @default(now())

  @@index([ocrResultId])
  @@map("prescription_ocr_pages")
}

// =======================================================
// PHASE 4: AI STRUCTURED EXTRACTION + DRUG NORMALIZATION
// =======================================================

model PrescriptionExtraction {
  id                String                   @id @default(uuid())
  prescriptionId    String                   @unique
  prescription      Prescription             @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  ocrResultId       String?
  provider          String                   // "openai" | "gemini" | "mock"
  model             String                   // "gpt-4o-mini" | "gemini-1.5-flash" | "mock-v1"
  status            String                   // "PENDING" | "PROCESSING" | "COMPLETED" | "NEEDS_REVIEW" | "FAILED"
  rawOcrText        String                   // Bản chụp văn bản OCR tại thời điểm trích xuất
  patientName       String?
  patientAge        String?
  patientGender     String?
  doctorName        String?
  diagnosis         String?
  medicationCount   Int                      @default(0)
  matchedCount      Int                      @default(0)
  needsReviewCount  Int                      @default(0)
  unmatchedCount    Int                      @default(0)
  attemptCount      Int                      @default(1)
  errorMessage      String?
  errorCode         String?
  processingTimeMs  Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  medications       PrescriptionMedication[]

  @@index([prescriptionId])
  @@index([status])
  @@map("prescription_extractions")
}

model PrescriptionMedication {
  id                  String                 @id @default(uuid())
  extractionId        String
  extraction          PrescriptionExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  rawName             String                 // Tên thuốc thô từ OCR (ví dụ: "Paracetamo1")
  normalizedName      String                 // Tên chuẩn hóa (ví dụ: "paracetamol")
  strength            String?                // Hàm lượng (ví dụ: "500mg" hoặc null)
  dosage              String?                // Liều dùng (ví dụ: "1 viên" hoặc null)
  frequency           String?                // Tần suất (ví dụ: "2 lần/ngày" hoặc null)
  duration            String?                // Thời gian (ví dụ: "5 ngày" hoặc null)
  quantity            String?                // Số lượng cấp (ví dụ: "10 viên" hoặc null)
  route               String?                // Đường dùng (ví dụ: "Uống" hoặc null)
  instructions        String?                // Hướng dẫn (ví dụ: "Uống sau ăn khi sốt" hoặc null)
  sourcePage          Int?                   // Trang OCR nguồn
  sourceText          String?                // Dòng text OCR nguồn
  matchStatus         String                 // "MATCHED" | "NEEDS_REVIEW" | "UNMATCHED"
  matchedDrugId       String?                // ID tham chiếu trong DrugReference
  matchedDrugName     String?                // Tên hiển thị của thuốc đã khớp
  matchScore          Float?                 // Điểm tương đồng thuật toán (0.0 - 1.0)
  candidatesJson      String?                // Top N ứng viên dạng JSON string
  userConfirmedDrugId String?                // ID thuốc người dùng xác nhận
  userConfirmedName   String?                // Tên thuốc người dùng xác nhận
  reviewStatus        String                 @default("PENDING_REVIEW") // "PENDING_REVIEW" | "CONFIRMED" | "REJECTED_UNKNOWN"
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([extractionId])
  @@index([matchStatus])
  @@index([reviewStatus])
  @@map("prescription_medications")
}

model DrugReference {
  id                   String   @id @default(uuid())
  brandName            String
  genericName          String
  activeIngredient     String?
  strength             String?
  dosageForm           String?
  manufacturer         String?
  normalizedSearchName String
  isPrescription       Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([normalizedSearchName])
  @@index([genericName])
  @@map("drug_references")
}
