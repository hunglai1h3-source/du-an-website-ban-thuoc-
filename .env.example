APP_NAME=PharmaTrust Data Hub
APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-value-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DATABASE_URL=postgresql+psycopg://pharmatrust:pharmatrust@postgres:5432/pharmatrust
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PUBLIC_API_MIN_SCORE=85
STORAGE_ROOT=/app/storage
MAX_UPLOAD_MB=20
ALLOW_PUBLIC_URL_IMPORT=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
AI_PROVIDER=ollama
VITE_API_URL=http://localhost:8000/api/v1
AUTO_CRAWL_ENABLED=true
AUTO_CRAWL_INTERVAL_HOURS=6
PHARMACITY_CRAWL_ENABLED=true
LONG_CHAU_CRAWL_ENABLED=true
DEFAULT_PUBLISH_MODE=MANUAL_REVIEW
PUBLIC_BROWSER_FALLBACK_ENABLED=true
CATEGORY_AI_THRESHOLD=0.85
JOB_LEASE_TIMEOUT_SECONDS=1800
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
